{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ vite_entry_link_tags('app') }}
{% endblock %}

{% block javascripts %}
    {{ vite_entry_script_tags('app') }}
{% endblock %}

{% block body %}
    <div id="app"></div>
    {# JSON_HEX_TAG escapes < and >, so no message can close the script element. #}
    <script type="application/json" id="translations">
        {{- translations|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_FORCE_OBJECT'))|raw -}}
    </script>
{% endblock %}
